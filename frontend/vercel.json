{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/registrati",
      "destination": "/app.html"
    },
    {
      "source": "/passa-a-pro",
      "destination": "/app.html"
    },
    {
      "source": "/accedi",
      "destination": "/app.html"
    },
    {
      "source": "/password-dimenticata",
      "destination": "/app.html"
    },
    {
      "source": "/reimposta-password",
      "destination": "/app.html"
    },
    {
      "source": "/le-mie-stime",
      "destination": "/app.html"
    },
    {
      "source": "/impostazioni",
      "destination": "/app.html"
    },
    {
      "source": "/impostazioni/:tab",
      "destination": "/app.html"
    },
    {
      "source": "/nuova-stima",
      "destination": "/app.html"
    },
    {
      "source": "/dettaglio-pro",
      "destination": "/app.html"
    },
    {
      "source": "/admin",
      "destination": "/app.html"
    },
    {
      "source": "/admin/:path*",
      "destination": "/app.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        },
        {
          "key": "Content-Security-Policy-Report-Only",
          "value": "default-src 'self'; script-src 'self' https://*.googletagmanager.com https://www.googleadservices.com https://googleads.g.doubleclick.net https://www.google.com https://connect.facebook.net; connect-src 'self' https://*.onrender.com https://*.renovio.it https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com https://*.g.doubleclick.net https://www.google.com https://www.googleadservices.com https://pagead2.googlesyndication.com https://www.facebook.com https://connect.facebook.net; img-src 'self' data: blob: https:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; frame-src https://td.doubleclick.net https://www.googletagmanager.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
