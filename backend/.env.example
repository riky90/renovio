DATABASE_URL=sqlite:///./dev.db
CORS_ORIGINS=http://localhost:5173

# --- Auth / session (AUTH-01..04) ---
# Firma i token itsdangerous (es. reset password). Generare con:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=
# Segreto DEDICATO per lo Starlette SessionMiddleware (flusso OAuth Google
# state/PKCE) — DEVE essere diverso da SECRET_KEY. Generare come sopra.
OAUTH_SESSION_SECRET=
# True in produzione dietro HTTPS (cookie Secure); False in dev locale su http.
COOKIE_SECURE=False

# --- Google OAuth (AUTH-02) ---
# Da Google Cloud Console -> API e servizi -> Credenziali -> ID client OAuth 2.0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Email transazionale (reset password D-04, riusata dai lead in Fase 4) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- URL pubblico del frontend (link email, redirect post-login Google) ---
FRONTEND_URL=http://localhost:5173

# --- Primo admin, promosso a role=admin da seed/bootstrap (D-03) ---
ADMIN_EMAIL=

# --- URL pubblico di QUESTO backend, senza slash finale ---
# Serve solo al backend di storage "db": un avatar servito da noi ha bisogno
# di un URL assoluto in User.avatar_url, perche' quel campo finisce in un
# <img src> renderizzato dal frontend, che gira su un'altra origine. In
# locale il default basta; su Render va messo l'URL del servizio.
BACKEND_PUBLIC_URL=http://localhost:8000

# --- Object storage avatar (Cloudflare R2, S3-compatibile) ---
# OPZIONALE. Senza questi cinque valori gli avatar finiscono nella tabella
# avatar_blob e li serve GET /api/v1/media/{key}: l'upload funziona lo
# stesso, non risponde piu' 503. Con tutti e cinque presenti vince R2, che
# resta la strada maestra (CDN, byte fuori dal database).
# Quale dei due e' attivo si legge da GET /health/db -> "storage".
# R2_PUBLIC_BASE_URL senza slash finale.
# R2_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=renovio-avatars
# R2_PUBLIC_BASE_URL=https://pub-<hash>.r2.dev
