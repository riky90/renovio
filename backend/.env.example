DATABASE_URL=sqlite:///./dev.db
CORS_ORIGINS=http://localhost:5173

# --- Auth / session (AUTH-01..04) ---
# Firma i token itsdangerous (es. reset password). Generare con:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=
# Segreto DEDICATO per lo Starlette SessionMiddleware (flusso OAuth Google
# state/PKCE) — DEVE essere diverso da SECRET_KEY. Generare come sopra.
OAUTH_SESSION_SECRET=
# True in produzione dietro HTTPS (cookie Secure); False in dev locale su http.
COOKIE_SECURE=False

# --- Google OAuth (AUTH-02) ---
# Da Google Cloud Console -> API e servizi -> Credenziali -> ID client OAuth 2.0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Email transazionale (reset password D-04, riusata dai lead in Fase 4) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- URL pubblico del frontend (link email, redirect post-login Google) ---
FRONTEND_URL=http://localhost:5173

# --- Primo admin, promosso a role=admin da seed/bootstrap (D-03) ---
ADMIN_EMAIL=

# --- Object storage avatar (Cloudflare R2, S3-compatibile) ---
# Senza questi cinque valori l'upload avatar risponde 503 e nessun altro
# endpoint cambia comportamento. R2_PUBLIC_BASE_URL senza slash finale.
# R2_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=renovio-avatars
# R2_PUBLIC_BASE_URL=https://pub-<hash>.r2.dev
